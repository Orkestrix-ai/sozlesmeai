# Bu dosya şablondur; gerçek değerleri `.env` içine yazın (git'e girmez).
# Faz 1'de (iskelet + design system + landing) bu değişkenlerin HİÇBİRİ
# okunmuyordu. Faz 2'den itibaren Supabase değerleri okunuyor.

# --- Supabase (Faz 2: auth, workspace, RLS) ---
# Değer yeni nesil `sb_publishable_...` anahtarıdır (eski `anon` JWT değil);
# ikisi de bu değişken adı altında çalışır.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Yalnızca sunucu tarafında kullanılır; asla NEXT_PUBLIC_ ile başlatmayın.
# Değer `sb_secret_...` biçimindedir. Faz 2'de hiçbir istek yolunda
# kullanılmaz (src/lib/supabase/admin.ts yalnızca ileriki seed/admin
# script'leri için hazır durur).
SUPABASE_SERVICE_ROLE_KEY=

# --- Anthropic Claude API (Faz 3: sözleşme taslağı üretimi) ---
ANTHROPIC_API_KEY=
