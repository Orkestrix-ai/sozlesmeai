# Bu dosya şablondur; gerçek değerleri `.env` içine yazın (git'e girmez).
# Faz 1'de (iskelet + design system + landing) bu değişkenlerin HİÇBİRİ
# okunmuyordu. Faz 2'den itibaren Supabase değerleri okunuyor.

# --- Supabase (Faz 2: auth, workspace, RLS) ---
# Değer yeni nesil `sb_publishable_...` anahtarıdır (eski `anon` JWT değil);
# ikisi de bu değişken adı altında çalışır.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Yalnızca sunucu tarafında kullanılır; asla NEXT_PUBLIC_ ile başlatmayın.
# Değer `sb_secret_...` biçimindedir. Faz 2'de hiçbir istek yolunda
# kullanılmaz (src/lib/supabase/admin.ts yalnızca ileriki seed/admin
# script'leri için hazır durur).
SUPABASE_SERVICE_ROLE_KEY=

# --- Uygulama kök adresi (Faz 2: e-posta onay/parola sıfırlama linkleri) ---
# Supabase'e gönderilen `emailRedirectTo` bu kökten kurulur ve Supabase
# Dashboard -> Authentication -> URL Configuration -> "Redirect URLs"
# listesiyle BİREBİR eşleşmek zorundadır; eşleşmezse GoTrue değeri sessizce
# atar ve "Site URL"e düşer (kullanıcı onay linkinde ham bir JSON hatası görür).
# Boş bırakılırsa `Host` başlığından türetilir - yerelde sorun değil, ama
# prod'da apex/www farkı ve preview URL'leri yüzünden sabit değer verin.
# Sondaki `/` yazılabilir, kod kırpar.
NEXT_PUBLIC_SITE_URL=

# --- LLM sağlayıcısı (Faz 3: sözleşme taslağı üretimi) ---
# Aktif sağlayıcı: "anthropic" (prod, varsayılan) veya "groq" (ucuz/geliştirme).
LLM_PROVIDER=anthropic

ANTHROPIC_API_KEY=

# console.groq.com'dan alınan key. LLM_PROVIDER=groq iken kullanılır.
GROQ_API_KEY=
