# Bu dosya şablondur; gerçek değerleri `.env.local` içine yazın (git'e girmez).
# Faz 1'de (iskelet + design system + landing) bu değişkenlerin HİÇBİRİ
# okunmuyor — Faz 2 ve Faz 3 için yer tutuyorlar.

# --- Supabase (Faz 2: auth, workspace, RLS, storage) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Yalnızca sunucu tarafında kullanılır; asla NEXT_PUBLIC_ ile başlatmayın.
SUPABASE_SERVICE_ROLE_KEY=

# --- Anthropic Claude API (Faz 3: sözleşme taslağı üretimi) ---
ANTHROPIC_API_KEY=
